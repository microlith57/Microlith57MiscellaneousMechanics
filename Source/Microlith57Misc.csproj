<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <AssemblyName>Microlith57MiscellaneousMechanics</AssemblyName>
        <RootNamespace>Celeste.Mod.Microlith57Misc</RootNamespace>
        <LangVersion>preview</LangVersion>
        <Nullable>enable</Nullable>
        <NuGetAuditLevel>critical</NuGetAuditLevel>
        <CelestePrefix Condition="'$(CelestePrefix)' == '' And Exists('..\..\..\Celeste.dll')">..\..\..</CelestePrefix>
        <CelestePrefix Condition="'$(CelestePrefix)' == ''">lib-stripped</CelestePrefix>
    </PropertyGroup>

    <PropertyGroup>
        <!-- If any feature flags were enabled, they would go here. -->
        <DefineConstants>$(DefineConstants);FEATURE_FLAG_BOX;FEATURE_FLAG_RECORDINGS</DefineConstants>
    </PropertyGroup>

    <ItemGroup>
        <Compile Remove="**/*.Rysy.cs" />
    </ItemGroup>

    <!--Disable "Copy Local" for all references-->
    <ItemDefinitionGroup>
        <PackageReference PrivateAssets="all" ExcludeAssets="runtime" />
        <Reference Private="false" />
    </ItemDefinitionGroup>

    <ItemGroup>
        <PackageReference Include="MonoMod.RuntimeDetour" Version="25.3.1" PrivateAssets="all" ExcludeAssets="runtime" />
        <PackageReference Include="MonoMod.Patcher" Version="25.0.0-prerelease.2" />
        <PackageReference Include="CelesteAnalyzer" Version="*" />
        <PackageReference Include="ModInteropImportGenerator" Version="*" />
        <PackageReference Include="CelesteMod.Roslyn.ModLifecycleAttributes" Version="*" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="CelesteMod.Publicizer" Version="*" CelesteAssembly="$(CelestePrefix)\Celeste.dll" />
        <Reference Include="$(CelestePrefix)\MMHOOK_Celeste.dll" Private="false" />
        <Reference Include="$(CelestePrefix)\FNA.dll" Private="false" />

        <Reference Include="lib\MaxHelpingHand.dll" Private="false" />
        <Reference Include="lib\EeveeHelper.dll" Private="false" />
        <Reference Include="lib\GravityHelper.dll" Private="false" />
    </ItemGroup>

    <Target Name="CopyFiles" AfterTargets="Build" Inputs="$(OutputPath)\$(AssemblyName).dll;$(OutputPath)\$(AssemblyName).pdb" Outputs="..\Code\bin\$(AssemblyName).dll;..\Code\bin\$(AssemblyName).pdb">
        <Copy SourceFiles="$(OutputPath)\$(AssemblyName).dll" DestinationFolder="..\Code\bin" />
        <Copy SourceFiles="$(OutputPath)\$(AssemblyName).pdb" DestinationFolder="..\Code\bin" />
    </Target>

    <PropertyGroup>
        <PathMap>$(MSBuildProjectDirectory)=Microlith57MiscellaneousMechanics/</PathMap>
    </PropertyGroup>

</Project>
